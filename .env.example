# AEGIS OMEGA ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to configure custom API keys.

# Optional: Google Gemini API Key for multimodal Generative AI reasoning
# If not provided, Aegis Omega automatically falls back to its built-in deterministic heuristic multi-agent engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External Threat Feed APIs
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
